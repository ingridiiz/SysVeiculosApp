<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SysVeiculosApp.MarcasPrincipal"
             Title="MarcasPrincipal">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">

            <CollectionView x:Name="collectionViewMarcas" 
                            HeightRequest="350" 
                            SelectionMode="Single" 
                            SelectionChanged="collectionViewMarcas_SelectionChanged">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <VerticalStackLayout Padding="10" BackgroundColor="#F5F5F5">
                            <Label Text="{Binding marnome}" FontSize="18" FontAttributes="Bold" TextColor="Black" />
                            <Label Text="{Binding marobservacoes}" FontSize="14" TextColor="Gray" />
                        </VerticalStackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Button Text="Inserir" Clicked="btnInserir_Clicked"/>
            <Button Text="Alterar" Clicked="btnAlterar_Clicked"/>
            <Button Text="Excluir" Clicked="btnExcluir_Clicked" BackgroundColor="#D32F2F" TextColor="White" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>