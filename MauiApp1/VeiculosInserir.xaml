<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SysVeiculosApp.VeiculosInserir"
             Title="Inserir Veículo">

    <ScrollView>
        <VerticalStackLayout Padding="15" Spacing="15">
            <Label Text="Cadastrar Novo Veículo" 
                   FontSize="20" 
                   FontAttributes="Bold" 
                   HorizontalOptions="Center" />

            <Label Text="Placa do Veículo:" FontAttributes="Bold" />
            <Entry x:Name="txtPlaca" Placeholder="Digite a placa" />

            <Label Text="Ano do Veículo:" FontAttributes="Bold" />
            <Entry x:Name="txtAno" Placeholder="Digite o ano" Keyboard="Numeric" />

            <Button x:Name="btnSalvar" Text="Salvar" Clicked="btnSalvarOnClick" BackgroundColor="#2E7D32" TextColor="White" />
            <Button x:Name="btnVoltar" Text="Voltar" Clicked="btnVoltarOnClick" BackgroundColor="#757575" TextColor="White" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>